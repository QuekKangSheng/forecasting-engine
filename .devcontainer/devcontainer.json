{
  "name": "Forecasting Engine",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  // Python 3.13: the version .python-version pins, which CI runs on.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app/Home.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // The dependencies, installed the way CI and the README install them: uv, from
  // pyproject.toml and uv.lock. Called through python3 -m so PATH doesn't matter.
  "updateContentCommand": "python3 -m pip install --user uv && python3 -m uv sync --all-extras",
  // app/Home.py is the entry file: it builds the navigation over app/app_pages/.
  "postAttachCommand": {
    "server": "python3 -m uv run streamlit run app/Home.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
